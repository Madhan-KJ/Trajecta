  "cost_components": [
    {
      "component": "fuel",
      "formula": "distance * fuel rate * terrain factor",
      "unit": "Rs"
    },
    {
      "component": "wages",
      "formula": "distance * wage rate + fixed vehicle route cost",
      "unit": "Rs"
    },
    {
      "component": "late penalty",
      "formula": "late days * daily rate",
      "unit": "Rs"
    },
    {
      "component": "packaging",
      "formula": "fragile order count * packaging rate",
      "unit": "Rs"
    },
    {
      "component": "cooling",
      "formula": "cooling order count * cooling rate",
      "unit": "Rs"
    },
    {
      "component": "maintenance",
      "formula": "distance * maintenance rate",
      "unit": "Rs"
    },
    {
      "component": "tolls",
      "formula": "flat class-based charge per active route",
      "unit": "Rs; synthetic assumption"
    },
    {
      "component": "EV charging",
      "formula": "distance * kWh/km * tariff",
      "unit": "Rs"
    }
  ],
  "cost_rates": {
    "cost_rate_scale": 1.16,
    "late_rate_rs_per_day": 100.0,
    "packaging_rs_per_order": 25.0,
    "cooling_rs_per_order": 10.0,
    "wage_rs_per_km": 2.0,
    "maintenance_rs_per_km": 0.55,
    "terrain_gradient_factor": 1.0,
